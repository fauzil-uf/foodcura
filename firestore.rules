rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Katalog Makanan Master (TKPI Kemenkes RI): Dapat dibaca oleh semua pengguna aplikasi
    match /foods/{foodId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Koleksi Global Artikel Edukasi Gizi & Food Waste: Dapat dibaca publik
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Profil Pengguna, Inventaris Pantry, Log Nutrisi, dan Notifikasi
    // Dilindungi secara ketat: Pengguna hanya dapat membaca dan menulis datanya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || userId.matches('user_.*'));
      
      match /pantry_items/{itemId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || userId.matches('user_.*'));
      }
      
      match /food_logs/{logId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || userId.matches('user_.*'));
      }
      
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || userId.matches('user_.*'));
      }
    }
  }
}
